# Copy to .env.production and fill in from the Supabase dashboard:
#   Project Settings → API Keys → "Publishable key"   (sb_publishable_...)
#   Project Settings → Data API → "Project URL"       (https://<ref>.supabase.co)
#
# The publishable key is not a secret — it grants nothing beyond what RLS
# allows — but the file stays out of git so a build can't silently pick up
# someone else's project.  Never put the secret / service_role key here: it
# would be compiled into the app and bypass RLS for anyone who unpacks it.
#
# Used by scripts/build_windows.ps1 and scripts/build_android.ps1, or directly:
#   flutter run --dart-define-from-file=../../.env.production
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
